# =============================================================================
# LogiFlow Master Environment Configuration (Docker Interpolation)
# =============================================================================

# --- Core App Settings ---
APP_NAME=LogiFlow
APP_ENV=local
APP_KEY=base64:3omtnEGTRkQv/KW6TERH38uZ0nfQkkok91X00QjGUac=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Port Assignments (Exposed to your laptop host) ---
FRONTEND_PORT=3000
NGINX_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=8900

# --- Next.js Configurations ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000

# --- Multi-Tenant Subdomain Cookie Sharing ---
# .localhost allows cookies to work on merchant-a.localhost and merchant-b.localhost
SESSION_DOMAIN=.localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,.localhost:3000

# --- PostgreSQL Relational Database Credentials ---
DB_DATABASE=logiflow_core
DB_USERNAME=logiflow_admin
DB_PASSWORD=secret_database_pass_123

# --- Redis Cache & Broadcasting Security ---
REDIS_PASSWORD=secret_redis_pass_123

# --- MinIO Object Cloud Storage Configurations ---
MINIO_ROOT_USER=logiflow_storage_admin
MINIO_ROOT_PASSWORD=secret_storage_pass_123
MINIO_BUCKET=logiflow-bucket
